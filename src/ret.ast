let vec1: <>int = <1, 2>;
let vev2: <>int = <4, 5>;
let vec3: <>int; -- Empty vector

vec1 <| 3; -- <1, 2, 3>
vec2 <| 6; -- <4, 5, 6>

vec1 <| vec2; -- vec1 = <1, 2, 3, 4, 5, 6>

vec1 |> vec2; -- vec1 = <1, 2, 3>

vec1 |> 3; -- vec1 = <1, 2>

let start: int = 0;
let end: int = 1;

vec3 = vec2<start..end>; -- slice <4, 5>

vec3.reserve(size);
vec3.clear();
